<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">24dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="text_margin">10dp</dimen>
    <dimen name="grid_spacing">14dp</dimen>

    <!-- Media tile: the shared grammar of the library, season and episode rows.
         Sizes follow the historic app tiles (90x110 poster, 32dp badge, ~14sp text). -->
    <dimen name="media_tile_padding">12dp</dimen>
    <dimen name="media_tile_spacing">10dp</dimen>
    <dimen name="media_tile_corner">14dp</dimen>
    <dimen name="media_tile_poster_width">85dp</dimen>
    <dimen name="media_tile_poster_height">120dp</dimen>
    <dimen name="media_tile_poster_corner">10dp</dimen>
    <dimen name="media_tile_poster_tag_text_size">8sp</dimen>
    <dimen name="media_tile_still_width">120dp</dimen>
    <dimen name="media_tile_still_height">68dp</dimen>
    <dimen name="media_tile_row_gap">6dp</dimen>
    <dimen name="media_tile_progress_height">5dp</dimen>
    <dimen name="media_tile_stroke_width">1dp</dimen>
    <dimen name="media_tile_toggle_size">32dp</dimen>
    <dimen name="media_tile_toggle_icon_size">24dp</dimen>
    <dimen name="media_tile_tag_padding_horizontal">8dp</dimen>
    <dimen name="media_tile_tag_padding_vertical">3dp</dimen>
    <dimen name="media_tile_tag_corner">8dp</dimen>
    <dimen name="media_tile_tag_spacing">8dp</dimen>
    <dimen name="media_tile_title_size">16sp</dimen>
    <dimen name="media_tile_meta_size">13sp</dimen>
    <dimen name="media_tile_tag_text_size">12sp</dimen>

    <!-- Discovery poster grid: poster card, and the badge/outline marking a title already
         present in the local library. -->
    <dimen name="discovery_card_corner">12dp</dimen>
    <dimen name="discovery_card_elevation">4dp</dimen>
    <dimen name="discovery_poster_height">240dp</dimen>
    <dimen name="discovery_in_library_stroke_width">2dp</dimen>
    <dimen name="discovery_badge_size">28dp</dimen>
    <dimen name="discovery_badge_margin">8dp</dimen>

    <!-- A-Z section divider of the library list screen. -->
    <dimen name="library_letter_header_padding_horizontal">14dp</dimen>
    <dimen name="library_letter_header_padding_vertical">8dp</dimen>
    <dimen name="library_letter_header_corner">10dp</dimen>
    <dimen name="library_letter_header_spacing">14dp</dimen>
    <dimen name="library_letter_size">22sp</dimen>

    <!-- Library list layout: the RecyclerView keeps an outer end margin for the bar, and an inner
         end padding so the tiles keep their distance from it. -->
    <dimen name="library_list_end_padding">12dp</dimen>

    <dimen name="fast_scroll_bar_width">5dp</dimen>
    <dimen name="fast_scroll_screen_margin">4dp</dimen>

    <!-- Search bar: pill-shaped field with a leading lens and a trailing clear button. The clear
         button keeps a 48dp touch target; its visible circle is inset inside that target. -->
    <dimen name="search_bar_min_height">56dp</dimen>
    <dimen name="search_bar_horizontal_padding">18dp</dimen>
    <dimen name="search_bar_end_padding">6dp</dimen>
    <dimen name="search_bar_icon_size">24dp</dimen>
    <dimen name="search_bar_icon_margin">12dp</dimen>
    <dimen name="search_bar_vertical_padding">14dp</dimen>
    <dimen name="search_bar_clear_touch_size">48dp</dimen>
    <dimen name="search_bar_clear_inset">8dp</dimen>
    <dimen name="search_bar_clear_icon_padding">15dp</dimen>

    <!-- Library settings bottom sheet: sectioned list of preferences and backup actions. -->
    <dimen name="divider_thickness">1dp</dimen>
    <dimen name="setting_row_min_height">56dp</dimen>
    <dimen name="setting_row_title_size">16sp</dimen>
    <dimen name="setting_row_description_size">13sp</dimen>
    <dimen name="setting_row_icon_size">24dp</dimen>
    <dimen name="setting_row_icon_margin">12dp</dimen>
    <dimen name="setting_row_gap">2dp</dimen>
</resources>
