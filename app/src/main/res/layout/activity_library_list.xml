<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal spacing uses both levers on purpose: the RecyclerView padding keeps the tiles away
     from both edges, while its end margin leaves room for the custom FastScrollBar, which is drawn
     over the list's right edge. The bar is attached in code. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/app_bar_main"
        layout="@layout/app_bar_main" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/fast_scroll_screen_margin"
        android:clipToPadding="false"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingEnd="@dimen/library_list_end_padding"
        android:paddingBottom="@dimen/activity_vertical_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar_main" />

    <fr.eseo.dis.amiaudluc.spinoffapp.ui.common.FastScrollBar
        android:id="@+id/library_fast_scroll"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/fast_scroll_screen_margin"
        app:layout_constraintBottom_toBottomOf="@id/library_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/library_list" />

    <include
        android:id="@+id/library_empty"
        layout="@layout/no_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar_main" />

</androidx.constraintlayout.widget.ConstraintLayout>
