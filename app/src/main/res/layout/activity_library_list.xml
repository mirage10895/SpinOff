<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal spacing uses both levers on purpose: the RecyclerView padding keeps the tiles away
     from both edges, while its end margin leaves room for the custom FastScrollBar, which is drawn
     over the list's right edge. The bar is attached in code. The sort chips scroll horizontally so
     the four modes stay reachable on narrow screens. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/app_bar_main"
        layout="@layout/app_bar_main" />

    <HorizontalScrollView
        android:id="@+id/sort_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/activity_horizontal_margin"
        android:paddingVertical="@dimen/library_sort_padding_vertical"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar_main">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_library_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_alphabetical"
                style="@style/BentoChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="true"
                android:text="@string/library_sort_alphabetical"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_year"
                style="@style/BentoChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:text="@string/library_sort_release_year"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_genre"
                style="@style/BentoChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:text="@string/library_sort_genre"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_rating"
                style="@style/BentoChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:text="@string/library_sort_rating"
                app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/fast_scroll_screen_margin"
        android:clipToPadding="false"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingEnd="@dimen/library_list_end_padding"
        android:paddingBottom="@dimen/activity_vertical_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sort_scroll" />

    <fr.eseo.dis.amiaudluc.spinoffapp.ui.common.FastScrollBar
        android:id="@+id/library_fast_scroll"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/fast_scroll_screen_margin"
        app:layout_constraintBottom_toBottomOf="@id/library_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/library_list" />

    <include
        android:id="@+id/library_empty"
        layout="@layout/no_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sort_scroll" />

</androidx.constraintlayout.widget.ConstraintLayout>
