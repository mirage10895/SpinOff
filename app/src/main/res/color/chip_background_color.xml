<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled first: an unavailable chip must stay dimmed even if it was left checked. -->
    <item android:color="@color/chip_background_disabled" android:state_enabled="false" />
    <item android:color="@color/colorPrimary" android:state_checked="true" />
    <item android:color="@color/card_background_color" android:state_checked="false" />
</selector>
